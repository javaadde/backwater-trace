  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one action colour, framed with an inner double rule; app size.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg>Report incident</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:6px;height:36px;padding:0 14px;font-family:var(--font-body);font-size:13px;font-weight:600;color:#f7f3ea;background:#24428f;border:1px solid #1b3374;border-radius:0;box-shadow:inset 0 0 0 2px #24428f,inset 0 0 0 3px #f7f3ea;cursor:pointer;transition:background-color 150ms,box-shadow 150ms}.ds-btn-primary:hover{background:#2d52a8;box-shadow:inset 0 0 0 2px #2d52a8,inset 0 0 0 3px #f7f3ea}.ds-btn-primary:active{background:#1b3374;box-shadow:inset 0 0 0 2px #1b3374,inset 0 0 0 3px #f7f3ea}.ds-btn-primary:focus-visible{outline:2px solid #24428f;outline-offset:2px}"
    },
    {
      "name": "Primary Button (landing)",
      "kind": "button",
      "refersTo": "button-primary-landing",
      "description": "Landing-size primary with a 3px ring and 1px paper rule; sinks 1px on press.",
      "html": "<button class=\"ds-btn-lx\">Report an incident</button>",
      "css": ".ds-btn-lx{display:inline-flex;align-items:center;min-height:52px;padding:0 24px 0 16px;font-family:var(--font-body);font-size:16px;font-weight:600;line-height:1;color:#f7f3ea;background:#24428f;border:1px solid #1b3374;border-radius:0;box-shadow:inset 0 0 0 3px #24428f,inset 0 0 0 4px #f7f3ea;cursor:pointer;transition:background-color 220ms cubic-bezier(0.16,1,0.3,1),box-shadow 220ms cubic-bezier(0.16,1,0.3,1),transform 120ms}.ds-btn-lx:hover{background:#2d52a8;box-shadow:inset 0 0 0 3px #2d52a8,inset 0 0 0 4px #f7f3ea}.ds-btn-lx:active{background:#1b3374;box-shadow:inset 0 0 0 3px #1b3374,inset 0 0 0 4px #f7f3ea;transform:translateY(1px)}.ds-btn-lx:focus-visible{outline:2px solid #24428f;outline-offset:3px}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Paper button with a black border and inner Rule Strong frame.",
      "html": "<button class=\"ds-btn-quiet\">Open evidence graph</button>",
      "css": ".ds-btn-quiet{display:inline-flex;align-items:center;height:36px;padding:0 14px;font-family:var(--font-body);font-size:14px;font-weight:500;color:#1a1712;background:#f7f3ea;border:1px solid #1a1712;border-radius:0;box-shadow:inset 0 0 0 2px #f7f3ea,inset 0 0 0 3px #b3a993;cursor:pointer;transition:background-color 150ms,box-shadow 150ms}.ds-btn-quiet:hover{background:#efe9dc;box-shadow:inset 0 0 0 2px #efe9dc,inset 0 0 0 3px #b3a993}.ds-btn-quiet:active{background:#e6dece}.ds-btn-quiet:focus-visible{outline:2px solid #24428f;outline-offset:2px}"
    },
    {
      "name": "Status Tags",
      "kind": "chip",
      "refersTo": "status-needs-verification",
      "description": "Square status tags; text always carries the meaning.",
      "html": "<span class=\"ds-tag ds-tag--new\">New</span> <span class=\"ds-tag ds-tag--check\">Needs verification</span> <span class=\"ds-tag ds-tag--ok\">Verified</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;height:22px;padding:0 6px;border:1px solid;font-family:var(--font-body);font-size:12px;font-weight:500;border-radius:0}.ds-tag--new{border-color:#1a1712;background:#f7f3ea;color:#1a1712}.ds-tag--check{border-color:#7f5200;background:#f1e2bf;color:#7f5200}.ds-tag--ok{border-color:#1f6b45;background:#dde8d6;color:#1f6b45}"
    },
    {
      "name": "Category Mark and Conflict Mark",
      "kind": "custom",
      "refersTo": "category-ink",
      "description": "Ink square with italic lowercase category name; vermilion cross-hatch swatch for possible conflict.",
      "html": "<span class=\"ds-kind\"><span class=\"ds-kind__ink\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M2 6c3-2 5 2 8 0s5-2 8 0 4 0 4 0M2 12c3-2 5 2 8 0s5-2 8 0 4 0 4 0M2 18c3-2 5 2 8 0s5-2 8 0 4 0 4 0\"/></svg></span><i>flood</i></span> <span class=\"ds-conflict\"><span class=\"ds-hatch\"></span>2 possible conflicts</span>",
      "css": ".ds-kind{display:inline-flex;align-items:center;gap:6px;color:#4f483c}.ds-kind__ink{display:inline-grid;place-items:center;width:20px;height:20px;background:#2a4d8f;color:#fff}.ds-kind i{font-family:var(--font-heading,\"Instrument Serif\",Georgia,serif);font-size:15px;font-weight:400}.ds-conflict{display:inline-flex;align-items:center;gap:6px;margin-left:16px;font-family:var(--font-body);font-size:12px;font-weight:600;color:#b8361f}.ds-hatch{display:inline-block;width:12px;height:12px;border:1px solid #b8361f;color:#b8361f;background-image:repeating-linear-gradient(45deg,currentColor 0 1px,transparent 1px 4px),repeating-linear-gradient(-45deg,currentColor 0 1px,transparent 1px 4px)}"
    },
    {
      "name": "Guide Words",
      "kind": "custom",
      "refersTo": "entry-row",
      "description": "Signature: first and last entry in view head the entry list, recomputed on scroll.",
      "html": "<div class=\"ds-guide\"><p>Canal blocked near Kainakary</p><span>14 shown</span><p>Waterlogging at Mullakkal</p></div>",
      "css": ".ds-guide{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:baseline;gap:12px;padding:12px 16px 10px;background:#f7f3ea;border-bottom:3px double #1a1712}.ds-guide p{margin:0;font-family:var(--font-heading,\"Instrument Serif\",Georgia,serif);font-weight:400;font-size:18px;line-height:1.25;color:#1a1712;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-guide p:last-child{text-align:right}.ds-guide span{font-family:var(--font-body);font-size:12px;color:#4f483c;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Entry Row",
      "kind": "card",
      "refersTo": "entry-row-selected",
      "description": "An incident entry in the list; selected state draws an inner black rule.",
      "html": "<div class=\"ds-entry\" tabindex=\"0\"><span class=\"ds-entry__ink\"></span><div><div class=\"ds-entry__top\"><span class=\"ds-entry__head\">Flooded road at Pallathuruthy</span><span class=\"ds-entry__time\">12m</span></div><div class=\"ds-entry__meta\">3 reports, Alappuzha North</div></div></div>",
      "css": ".ds-entry{display:grid;grid-template-columns:20px minmax(0,1fr);gap:0 12px;padding:16px;background:#f7f3ea;border-bottom:1px solid #d6cdba;cursor:pointer;transition:background-color 200ms}.ds-entry:hover{background:#efe9dc}.ds-entry:focus-visible{outline:2px solid #24428f;outline-offset:-2px;background:#efe9dc;box-shadow:inset 0 0 0 1px #1a1712}.ds-entry__ink{width:20px;height:20px;margin-top:4px;background:#2a4d8f}.ds-entry__top{display:flex;align-items:baseline;justify-content:space-between;gap:12px}.ds-entry__head{font-family:var(--font-heading,\"Instrument Serif\",Georgia,serif);font-size:19px;line-height:1.25;color:#1a1712;word-spacing:0.14em}.ds-entry__time{font-size:11px;color:#665e50;font-variant-numeric:tabular-nums}.ds-entry__meta{margin-top:4px;font-family:var(--font-body);font-size:13px;color:#4f483c}"
    },
    {
      "name": "Plate",
      "kind": "card",
      "refersTo": "plate",
      "description": "Bordered frame that holds all colour: map, screenshots; serif plate number caption.",
      "html": "<figure class=\"ds-plate\"><div class=\"ds-plate__frame\"></div><figcaption><span>Plate I.</span> The incident board, showing synthetic demo data.</figcaption></figure>",
      "css": ".ds-plate{margin:0;max-width:320px}.ds-plate__frame{height:180px;margin:5px;background:#efe9dc;border:1px solid #1a1712;outline:1px solid #1a1712;outline-offset:4px}.ds-plate figcaption{margin-top:16px;font-family:var(--font-body);font-size:14px;color:#665e50}.ds-plate figcaption span{font-family:var(--font-heading,\"Instrument Serif\",Georgia,serif);font-size:18px;color:#1a1712}"
    },
    {
      "name": "Masthead",
      "kind": "nav",
      "refersTo": "button-primary",
      "description": "Sticky 64px masthead closed by a double rule; current link underlined in black.",
      "html": "<header class=\"ds-mast\"><span class=\"ds-mast__word\">Backwater Trace</span><nav><a href=\"#\" aria-current=\"page\">Incident board</a></nav><button class=\"ds-mast__btn\">Report incident</button></header>",
