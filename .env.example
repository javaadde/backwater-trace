# Copy to .env.local. Never commit real values. All are server-only (no NEXT_PUBLIC_ prefix).

# Supabase — leave blank to use the local JSON store in .data/ (dev only)
SUPABASE_URL=
# New-style secret key (sb_secret_...) preferred; legacy service_role key also works
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (Session pooler URI), only needed to apply supabase/schema.sql
SUPABASE_DB_URL=

# Sarvam AI speech-to-text
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_LANGUAGE_CODE=ml-IN
# Set to 1 to return a canned Malayalam transcript (rehearsal / demo backup only)
SARVAM_MOCK=0

# Incident matching threshold (same category 3 + within 500 m 4 + within 3 h 2 + similar words 2)
MATCH_THRESHOLD=7

# Public production origin (canonical URLs, sitemap, llms.txt). Falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=
